# Public build-time variables (no secrets here: the repository is public).
# Cloudflare Turnstile site key for the contact form. Without it the form is replaced by
# a "temporarily unavailable" notice. For local testing use the always-pass test key.
PUBLIC_TURNSTILE_SITEKEY=
# PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Search-engine indexing. Default (unset/false): every page is noindex,nofollow and robots.txt
# disallows all, which is right for the workers.dev dev domain and PR previews. The PRODUCTION
# build sets this to true (Workers Builds → Build variables). Previews of other branches stay
# noindex even then (WORKERS_CI_BRANCH != main).
PUBLIC_INDEXABLE=
