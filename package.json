{
  "name": "hyperborea",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/build-images.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-images.mjs",
    "build": "astro build && pagefind --site dist && node scripts/build-redirects.mjs && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && npm run check:worker",
    "import": "node scripts/import-drupal.mjs",
    "import:all": "node scripts/import-drupal.mjs --all",
    "import:terms": "node scripts/import-keyword-terms.mjs",
    "fix:links": "node scripts/relativize-links.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file worker/secrets.example",
    "check:worker": "npm run types --silent && tsc -p worker/tsconfig.json",
    "a11y": "node scripts/a11y.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check:headers": "node scripts/check-headers.mjs",
    "images": "node scripts/build-images.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/lato": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  }
}
