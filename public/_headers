# Cloudflare Workers Assets headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Applies to static files only; responses from worker/index.ts (/api/*) set their own.
# The page CSP (script/style hashes) is generated by Astro (security.csp in
# astro.config.mjs) as a <meta>; the directives a <meta> cannot carry go here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Hashed build output: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind: index/, fragment/ and filter/ files carry a content hash in their name;
# the entry point and the JS/CSS/wasm do not.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

# Media keeps the same URLs as the old Drupal site (an editor may replace a file
# under the same name), so cache for a week and revalidate in the background.
/sites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Sveltia CMS (served at /admin; /admin/* covers anything under it): never cached,
# never indexed. Both policies apply (this one and frame-ancestors above), so this CSP
# only lists what the CMS needs: its script from unpkg (pinned, with SRI in
# admin/index.html), GitHub's API for content and uploads, and blob/data images.
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data: https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' data: https://www.githubstatus.com https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data: https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' data: https://www.githubstatus.com https://api.github.com https://raw.githubusercontent.com https://*.githubusercontent.com https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
