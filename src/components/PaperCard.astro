---
import type { Locale } from "../i18n/config";

interface Props {
  title: string;
  href: string;
  image?: string;
  columns?: 2 | 3;
  /** Heading level of the title: 2 under the page's <h1>, 3 below a section <h2> (home page). */
  level?: 2 | 3;
  /** Language of the title when it differs from the page's (untranslated Spanish fallback). */
  titleLang?: Locale;
}
const { title, href, image, columns = 3, level = 2, titleLang } = Astro.props;
const Heading = `h${level}` as const;
---

<article class:list={["hb-card", `hb-card--${columns}`]}>
  {/* The picture repeats the title's link: one tab stop and one announcement per card, so this
      link is hidden from keyboard and screen readers and the image is decorative (alt=""). */}
  <a class="hb-card-media" href={href} aria-hidden="true" tabindex="-1">
    {image && <img src={image} alt="" width="750" height="500" loading="lazy" />}
    <span class="hb-card-overlay" aria-hidden="true">+</span>
  </a>
  <div class="hb-card-body">
    <Heading class="hb-card-title"><a href={href} lang={titleLang}>{title}</a></Heading>
  </div>
</article>
