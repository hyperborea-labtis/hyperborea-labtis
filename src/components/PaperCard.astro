---
import type { Locale } from "../i18n/config";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
  title: string;
  href: string;
  image?: string;
  columns?: 2 | 3;
  /** Heading level of the title: 2 under the page's <h1>, 3 below a section <h2> (home page). */
  level?: 2 | 3;
  /** Language of the title when it differs from the page's (untranslated Spanish fallback). */
  titleLang?: Locale;
  /** Image above the fold: load it now instead of lazily. */
  eager?: boolean;
  /** The first card of the page: its image is the LCP candidate, fetch it first. */
  priority?: boolean;
}
const { title, href, image, columns = 3, level = 2, titleLang, eager = false, priority = false } = Astro.props;
// Width the picture is drawn at: a column of the grid (the grid is one column on phones).
const sizes =
  columns === 3
    ? "(max-width: 767px) calc(100vw - 30px), (min-width: 1200px) 360px, 33vw"
    : "(max-width: 767px) calc(100vw - 30px), 50vw";
const Heading = `h${level}` as const;
---

<article class:list={["hb-card", `hb-card--${columns}`]}>
  {/* The picture repeats the title's link: one tab stop and one announcement per card, so this
      link is hidden from keyboard and screen readers and the image is decorative (alt=""). */}
  <a class="hb-card-media" href={href} aria-hidden="true" tabindex="-1">
    {image && <ResponsiveImage src={image} kind="card" alt="" sizes={sizes} fallbackWidth={750} fallbackHeight={500} eager={eager} priority={priority} />}
    <span class="hb-card-overlay" aria-hidden="true">+</span>
  </a>
  <div class="hb-card-body">
    <Heading class="hb-card-title"><a href={href} lang={titleLang}>{title}</a></Heading>
  </div>
</article>
