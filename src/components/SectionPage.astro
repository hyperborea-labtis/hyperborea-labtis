---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "./PageTitle.astro";
import PaperCard from "./PaperCard.astro";
import Pager from "./Pager.astro";
import type { Locale } from "../i18n/config";
import type { Section } from "../data/nav";
import { papersInSection, papersInSectionNewestFirst, langIfDifferent, paginate } from "../lib/content";
import { sectionDescription, pageSuffix, withPage } from "../lib/descriptions";

interface Props {
  lang: Locale;
  section: Section;
  /** 1-based page, only for sections that list every issue (`allIssues`). */
  page?: number;
}

const { lang, section, page = 1 } = Astro.props;
// Most sections show the current issue only. `allIssues` sections (Afinidades
// electivas) show everything, newest first, paginated.
const all = section.allIssues
  ? await papersInSectionNewestFirst(lang, section.label)
  : await papersInSection(lang, section.label);
const paged = section.allIssues ? paginate(all, page) : undefined;
const papers = paged ? paged.items : all;
const base = `/${lang}/${section.path}`;
const path = page === 1 ? `/${section.path}` : `/${section.path}/${page}`;
---

<BaseLayout
  title={page === 1 ? section.label : `${section.label} — ${pageSuffix(lang, page)}`}
  description={withPage(sectionDescription(lang, { label: section.label, count: all.length }), lang, page)}
  lang={lang}
  path={path}
  breadcrumbs={[{ name: section.label, path }]}
>
  <div class="hb-main">
    <div class="hb-container">
      <PageTitle text={section.label} />
      <div class="hb-grid">
        {
          papers.map((p, n) => (
            <PaperCard
              title={p.data.title}
              href={`/${lang}/paper/${p.data.slug}`}
              image={p.data.heroImage}
              columns={2}
              titleLang={langIfDifferent(p, lang)}
              eager={n === 0}
              priority={n === 0}
            />
          ))
        }
      </div>
      {paged && <Pager lang={lang} base={base} current={page} total={paged.totalPages} />}
    </div>
  </div>
</BaseLayout>
