---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "./PageTitle.astro";
import PaperCard from "./PaperCard.astro";
import type { Locale } from "../i18n/config";
import type { Section } from "../data/nav";
import { papersInSection } from "../lib/content";

interface Props {
  lang: Locale;
  section: Section;
}

const { lang, section } = Astro.props;
const papers = await papersInSection(lang, section.label);
---

<BaseLayout title={`${section.label} | Hyperborea`} lang={lang} path={`/${section.path}`}>
  <div class="hb-main">
    <div class="hb-container">
      <PageTitle text={section.label} />
      <div class="hb-grid">
        {
          papers.map((p) => (
            <PaperCard
              title={p.data.title}
              href={`/${lang}/paper/${p.data.slug}`}
              image={p.data.heroImage}
              columns={2}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
