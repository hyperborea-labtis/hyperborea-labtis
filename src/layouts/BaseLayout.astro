---
import "@fontsource/lato/300.css";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "@fontsource/lato/900.css";
import "../styles/hyperborea.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, type Locale } from "../i18n/config";
import { absoluteUrl, ogLocale, resolveHead } from "../lib/seo";
import { INDEXABLE } from "../lib/indexing";

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  /** Locale-relative path (same across languages): canonical, hreflang and the language switcher. */
  path?: string;
  footerVariant?: "full" | "minimal";
  /** Language of the text on the page. Different from `lang` = untranslated Spanish fallback:
   * canonical to the Spanish page and noindex (see src/lib/seo.ts). */
  contentLang?: Locale;
  /** Languages with REAL content at this path (default: all). Only these get hreflang. */
  alternates?: readonly Locale[];
  /** Keep the page out of search results (search, 404…). */
  noindex?: boolean;
  /** Emit no canonical, hreflang or og:url (the 404 page has no address of its own). */
  canonical?: boolean;
  /** Social image: a site-relative path such as a paper's hero image. Default: the logo card. */
  image?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description = "Hyperborea — Revista de Ensayo y Creación.",
  lang,
  path = "",
  footerVariant = "minimal",
  contentLang,
  alternates,
  noindex = false,
  canonical = true,
  image,
  ogType = "website",
} = Astro.props;

const site = Astro.site!;
const head = resolveHead({ lang, path, site, locales, indexable: INDEXABLE, contentLang, alternates, noindex });
const imageUrl = absoluteUrl(image || "/og-default.png", site);
const otherLocales = head.hreflang
  .filter((h) => h.hreflang !== "x-default" && h.hreflang !== lang)
  .map((h) => ogLocale(h.hreflang as Locale));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={head.robots} />
    {canonical && <link rel="canonical" href={head.canonical} />}
    {canonical && head.hreflang.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}

    <meta property="og:site_name" content="Hyperborea" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={head.canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Hyperborea" href={`/${lang}/rss.xml`} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="hb-root">
      <Header lang={lang} path={path} />
      <main id="main-content">
        <slot />
      </main>
      <Footer lang={lang} variant={footerVariant} />
    </div>
  </body>
</html>
