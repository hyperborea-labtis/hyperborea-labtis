---
// One dynamic segment serves both institutional pages (/es/presentacion) and
// section pages (/es/Mare_Sugenum): the old Drupal site published both at the
// language root, and those URLs must keep working.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import SectionPage from "../../components/SectionPage.astro";
import { locales, useTranslations, type Locale } from "../../i18n/config";
import { ALL_SECTIONS } from "../../data/nav";
import { pagesForLocale, pageBySlug, contentLangOf, langIfDifferent, realLocales } from "../../lib/content";
import { textDescription } from "../../lib/descriptions";
import { organizationNode, pageNode, websiteNode } from "../../lib/jsonld";
import { absoluteUrl } from "../../lib/seo";

export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of locales) {
    for (const page of await pagesForLocale(lang)) {
      paths.push({ params: { lang, page: page.data.slug } });
    }
    for (const section of ALL_SECTIONS) {
      paths.push({ params: { lang, page: section.path } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const slug = Astro.params.page as string;
const t = useTranslations(lang);
const section = ALL_SECTIONS.find((s) => s.path === slug);
const page = section ? undefined : await pageBySlug(lang, slug);
if (!section && !page) return Astro.redirect(`/${lang}`);
const Content = page ? (await render(page)).Content : undefined;
const contentLang = page ? contentLangOf(page) : lang;
const alternates = page ? ((await realLocales("pages")).get(slug) ?? [contentLang]) : locales;
const site = Astro.site!.href;
const pageDescription = page ? textDescription(lang, { body: page.body ?? "", title: page.data.title }) : "";
const jsonLd = page
  ? [pageNode(site, { lang: contentLang, url: absoluteUrl(`/${lang}/${slug}`, site), title: page.data.title, description: pageDescription }), websiteNode(site, lang), organizationNode(site)]
  : [];
---

{section && <SectionPage lang={lang} section={section} />}
{
  page && Content && (
    <BaseLayout
      title={page.data.title}
      description={pageDescription}
      jsonLd={jsonLd}
      breadcrumbs={[{ name: page.data.title, path: `/${slug}` }]}
      lang={lang}
      path={`/${slug}`}
      contentLang={contentLang}
      alternates={alternates}
    >
      <div class="hb-main">
        <div class="hb-container" data-pagefind-body>
          <meta data-pagefind-filter="tipo[content]" content={t("search.type.page")} />
          <PageTitle text={page.data.title} lang={langIfDifferent(page, lang)} />
          <article class="hb-article" lang={langIfDifferent(page, lang)}>
            <Content />
          </article>
        </div>
      </div>
    </BaseLayout>
  )
}
