---
// Activities list, page 1 (same URL as the current Drupal site: /es/actividades);
// pages 2+ are actividades/[n].astro.
import type { GetStaticPaths } from "astro";
import ActivitiesPage from "../../components/ActivitiesPage.astro";
import { locales, type Locale } from "../../i18n/config";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<ActivitiesPage lang={lang} page={1} />
