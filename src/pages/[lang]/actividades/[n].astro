---
// Activities list, pages 2 and up (page 1 is ../actividades.astro).
import type { GetStaticPaths } from "astro";
import ActivitiesPage from "../../../components/ActivitiesPage.astro";
import { locales, type Locale } from "../../../i18n/config";
import { articlesForLocale, paginate } from "../../../lib/content";

export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of locales) {
    const { totalPages } = paginate(await articlesForLocale(lang), 1);
    for (let n = 2; n <= totalPages; n++) paths.push({ params: { lang, n: String(n) } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const page = Number(Astro.params.n);
---

<ActivitiesPage lang={lang} page={page} />
