---
// Contact page, same URL as the old Drupal site (/es/contact). Readers write to the journal's address
// (JOURNAL.contactEmail): there is no form. The Worker in worker/index.ts (POST /api/contact, Turnstile,
// Email Service) is kept in the repository but nothing calls it; see the README to bring the form back.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTitle from "../../components/PageTitle.astro";
import { JOURNAL } from "../../data/journal";
import { locales, type Locale } from "../../i18n/config";
import { listingDescription } from "../../lib/descriptions";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;

const text: Record<Locale, { title: string; intro: string }> = {
  es: { title: "Contacto", intro: "Para comunicarse con la revista, escriba a" },
  en: { title: "Contact", intro: "To get in touch with the journal, write to" },
  fr: { title: "Contact", intro: "Pour contacter la revue, écrivez à" },
};
const t = text[lang];
---

<BaseLayout title={t.title} description={listingDescription(lang, "contact")} lang={lang} path="/contact" breadcrumbs={[{ name: t.title, path: "/contact" }]}>
  <div class="hb-main">
    <div class="hb-container">
      <PageTitle text={t.title} />
      <p class="hb-contact-email">
        {t.intro} <a href={`mailto:${JOURNAL.contactEmail}`}>{JOURNAL.contactEmail}</a>
      </p>
    </div>
  </div>
</BaseLayout>
