---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperCard from "../../components/PaperCard.astro";
import { locales, useTranslations, type Locale } from "../../i18n/config";
import { homePublications } from "../../lib/content";

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const publications = await homePublications(lang);

// Intro block (block_content in Drupal; translate en/fr before launch).
const intros: Record<Locale, string> = {
  es: "<strong>Hyperborea. Revista de ensayo y creación</strong> es una publicación digital anual sobre literatura, arte y cine del Laboratorio Texto, imagen y sociedad \[LabTIS\], que funciona en la Sede Andina de la Universidad Nacional de Río Negro desde el año 2016. Las secciones de la revista descansan en los criterios de un equipo compuesto por editores/as que, junto con la dirección de la publicación, se desempeñan como docentes e investigadores en la Universidad Nacional de Río Negro, Universidad de Buenos Aires, Universidad Nacional de La Plata, Universidad Nacional de Rosario, Université Paris Sorbonne, Instituto de Investigaciones Bibliográficas de la Universidad Nacional Autónoma de México, Comisión Nacional de Investigación Científica y Tecnológica de Chile \[CONICYT\] y el Consejo Nacional de Investigaciones Científico Técnicas de la República Argentina \[CONICET\]; algunos de ellos, a la par de lo anterior, son traductores, escritores y realizadores de cine de autor.",
  en: "<strong>Hyperborea. Journal of Essay and Creation</strong> is an annual digital publication on literature, art and film by the Text, Image and Society Laboratory [LabTIS] at the Universidad Nacional de Río Negro, Argentina, since 2016.",
  fr: "<strong>Hyperborea. Revue d’essai et de création</strong> est une publication numérique annuelle consacrée à la littérature, à l’art et au cinéma, éditée par le Laboratoire Texte, image et société [LabTIS] de l’Universidad Nacional de Río Negro, depuis 2016.",
};
---

<BaseLayout title="Hyperborea. Revista de Ensayo y Creación" lang={lang} path="" footerVariant="full">
  <section class="hb-lead">
    <div class="hb-container">
      <p set:html={intros[lang]} />
    </div>
  </section>

  <section class="hb-featured">
    <div class="hb-container">
      <h2 class="hb-section-title">{t("home.latest")}</h2>
      <div class="hb-grid">
        {
          publications.map((p) => (
            <PaperCard title={p.title} href={p.href} image={p.image} columns={3} />
          ))
        }
      </div>
      <p class="hb-more"><a href={`/${lang}/posts-3-col`}>{t("home.more")}</a></p>
    </div>
  </section>
</BaseLayout>
