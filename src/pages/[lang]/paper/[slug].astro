---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageTitle from "../../../components/PageTitle.astro";
import { locales, useTranslations, type Locale } from "../../../i18n/config";
import { papersForLocale, paperBySlug, norm } from "../../../lib/content";
import { ALL_SECTIONS } from "../../../data/nav";
import { termIdByName } from "../../../lib/keywords";

export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of locales) {
    for (const paper of await papersForLocale(lang)) {
      paths.push({ params: { lang, slug: paper.data.slug } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const paper = await paperBySlug(lang, slug);
if (!paper) return Astro.redirect(`/${lang}`);
const { Content } = await render(paper);
const d = paper.data;

// Category (section) and keywords shown after the article, like the old site:
// the section links to its page, each keyword to its /taxonomy/term/<id> page.
const section = ALL_SECTIONS.find((s) => s.label === d.section);
const keywords = d.keywords.map((name) => ({ name, tid: termIdByName.get(norm(name)) }));
---

<BaseLayout
  title={`${d.title} | Hyperborea`}
  description={d.abstract?.slice(0, 180)}
  lang={lang}
  path={`/paper/${slug}`}
>
  <div class="hb-main">
    <div class="hb-container" data-pagefind-body>
      <meta data-pagefind-filter="tipo[content]" content={t("search.type.paper")} />
      {d.section && <meta data-pagefind-filter="seccion[content]" content={d.section} />}
      {d.issue !== undefined && <meta data-pagefind-filter="numero[content]" content={String(d.issue)} />}
      <PageTitle text={d.title} />

      <article class="hb-article">
        {d.heroImage && (
          <img
            class="image-style-mt-slideshow-boxed"
            src={d.heroImage}
            alt={d.title}
            width="1140"
            height="630"
          />
        )}

        {d.author && (
          <p class="hb-article-author text-align-right">
            {d.author}
            {d.email && (<><br />{d.email}</>)}
            {d.affiliation && (<><br />{d.affiliation}</>)}
          </p>
        )}

        <Content />

        {(section || keywords.length > 0) && (
          <div class="hb-tags">
            {section && (
              <ul class="hb-tag-list" aria-label={t("paper.category")}>
                <li><a href={`/${lang}/${section.path}`}>{section.label}</a></li>
              </ul>
            )}
            {keywords.length > 0 && (
              <ul class="hb-tag-list" aria-label={t("paper.keywords")}>
                {keywords.map((k) => (
                  <li>{k.tid ? <a href={`/${lang}/taxonomy/term/${k.tid}`}>{k.name}</a> : <span>{k.name}</span>}</li>
                ))}
              </ul>
            )}
          </div>
        )}

        {d.pdf && (
          <p class="hb-pdf">
            <a href={d.pdf} target="_blank" rel="noopener">{t("paper.pdf")}</a>
          </p>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
