---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageTitle from "../../../components/PageTitle.astro";
import ResponsiveImage from "../../../components/ResponsiveImage.astro";
import SearchFilter from "../../../components/SearchFilter.astro";
import PaperMeta from "../../../components/PaperMeta.astro";
import LicenseNotice from "../../../components/LicenseNotice.astro";
import { locales, useTranslations, type Locale } from "../../../i18n/config";
import { papersForLocale, paperBySlug, norm, contentLangOf, langIfDifferent, realLocales, type Paper } from "../../../lib/content";
import { ALL_SECTIONS } from "../../../data/nav";
import { termIdByName } from "../../../lib/keywords";
import { splitAuthor, noteAnchor } from "../../../lib/author";
import { paperDescription } from "../../../lib/descriptions";
import { JOURNAL } from "../../../data/journal";
import { ISSUE_YEARS, issueTitle } from "../../../data/issues";
import { parseAuthors, scholarDate, isoDate, scholarTags } from "../../../lib/scholar";
import { articleNode, issueNode, organizationNode, periodicalNode } from "../../../lib/jsonld";
import { absoluteUrl } from "../../../lib/seo";
import { plainText } from "../../../lib/meta-text";
import { relatedPapers } from "../../../lib/related";
import { bodyHasAbstract } from "../../../lib/abstract";

export const getStaticPaths = (async () => {
  const paths = [];
  for (const lang of locales) {
    for (const paper of await papersForLocale(lang)) {
      paths.push({ params: { lang, slug: paper.data.slug } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const paper = await paperBySlug(lang, slug);
if (!paper) return Astro.redirect(`/${lang}`);
const { Content } = await render(paper);
const d = paper.data;
const contentLang = contentLangOf(paper);
const textLang = langIfDifferent(paper, lang);
const alternates = (await realLocales("papers")).get(slug) ?? [contentLang];
const authorParts = splitAuthor(d.author ?? "");

// Scholarly metadata (Google Scholar citation_* tags) and schema.org JSON-LD. BaseLayout emits
// both only on indexable pages, so untranslated /en and /fr copies carry neither.
const site = Astro.site!.href;
const paperUrl = absoluteUrl(`/${lang}/paper/${slug}`, site);
const issueYear = d.issue !== undefined ? ISSUE_YEARS[d.issue] : undefined;
const authors = parseAuthors(d.author);
const pdfUrl = d.pdf ? absoluteUrl(d.pdf, site) : undefined;
const scholar = scholarTags({
  title: d.title.replace(/\s+/g, " ").trim(),
  authors,
  institution: d.affiliation,
  date: scholarDate(d.publishedDate, issueYear),
  journal: JOURNAL.name,
  issn: JOURNAL.issn,
  volume: d.issue,
  language: contentLang,
  keywords: d.keywords,
  abstractUrl: paperUrl,
  pdfUrl,
  publisher: JOURNAL.publisher.name,
});
const issue = d.issue !== undefined && issueYear
  ? issueNode(site, { lang, n: d.issue, year: issueYear, title: issueTitle(d.issue) })
  : undefined;
const jsonLd = issue
  ? [
      articleNode(site, {
        lang: contentLang, url: paperUrl, title: d.title.replace(/\s+/g, " ").trim(), authors, institution: d.affiliation,
        date: isoDate(d.publishedDate, issueYear), keywords: d.keywords, abstract: d.abstract ? plainText(d.abstract) : undefined,
        section: d.section, image: d.heroImage ? absoluteUrl(d.heroImage, site) : undefined, pdfUrl, issue,
      }),
      issue,
      periodicalNode(site),
      organizationNode(site),
    ]
  : [];
const breadcrumbs = [
  ...(d.issue !== undefined && issueYear ? [{ name: issueTitle(d.issue), path: `/numero-${d.issue}` }] : []),
  { name: d.title.replace(/\s+/g, " ").trim(), path: `/paper/${slug}` },
];

// Category (section) and keywords shown after the article, like the old site:
// the section links to its page, each keyword to its /taxonomy/term/<id> page.
const section = ALL_SECTIONS.find((s) => s.label === d.section);
const keywords = d.keywords.map((name) => ({ name, tid: termIdByName.get(norm(name)) }));

// Related articles: other papers on the same subject (shared keywords) or in the same issue.
const toRelated = (p: Paper) => ({
  slug: p.data.slug,
  keywords: p.data.keywords,
  issue: p.data.issue,
  section: p.data.section,
  date: (p.data.created ?? p.data.publishedDate)?.getTime() ?? 0,
  entry: p,
});
const related = relatedPapers(toRelated(paper), (await papersForLocale(lang)).map(toRelated));
---

<BaseLayout
  title={d.title}
  description={paperDescription(lang, { abstract: d.abstract, body: paper.body ?? "", author: authorParts.name, issue: d.issue })}
  lang={lang}
  path={`/paper/${slug}`}
  contentLang={contentLang}
  alternates={alternates}
  ogType="article"
  image={d.heroImage}
  metaTags={scholar}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <div class="hb-main">
    <div class="hb-container" data-pagefind-body>
      <SearchFilter name="tipo" value={t("search.type.paper")} />
      {d.section && <SearchFilter name="seccion" value={d.section} />}
      {d.issue !== undefined && <SearchFilter name="numero" value={String(d.issue)} />}
      <PageTitle text={d.title} lang={textLang} />

      <article class="hb-article" lang={textLang}>
        {d.heroImage && (
          <ResponsiveImage
            class="image-style-mt-slideshow-boxed"
            src={d.heroImage}
            kind="hero"
            alt={d.heroAlt ?? ""}
            sizes="(min-width: 992px) 940px, calc(100vw - 78px)"
            fallbackWidth={1140}
            fallbackHeight={630}
            eager
            priority
          />
        )}

        {d.author && (
          <p class="hb-article-author text-align-right">
            {authorParts.name}
            {authorParts.note && (<a href={`#${noteAnchor(authorParts.note)}`}>[{authorParts.note}]</a>)}
            {d.email && (<><br />{d.email}</>)}
            {d.affiliation && (<><br />{d.affiliation}</>)}
          </p>
        )}

        {d.abstract && !bodyHasAbstract(paper.body ?? "") && (
          <section class="hb-abstract" aria-labelledby="abstract-title">
            <h2 id="abstract-title">{t("paper.abstract")}</h2>
            <p lang={contentLang}>{d.abstract}</p>
            {d.abstractSource === "editorial" && <p class="hb-abstract-source">{t("paper.abstractEditorial")}</p>}
          </section>
        )}

        <Content />

        {(section || keywords.length > 0) && (
          <div class="hb-tags">
            {section && (
              <ul class="hb-tag-list" aria-label={t("paper.category")}>
                <li><a href={`/${lang}/${section.path}`}>{section.label}</a></li>
              </ul>
            )}
            {keywords.length > 0 && (
              <ul class="hb-tag-list" aria-label={t("paper.keywords")}>
                {keywords.map((k) => (
                  <li>{k.tid ? <a href={`/${lang}/taxonomy/term/${k.tid}`}>{k.name}</a> : <span>{k.name}</span>}</li>
                ))}
              </ul>
            )}
          </div>
        )}

        <PaperMeta lang={lang} paper={paper} />
        {related.length > 0 && (
          <section class="hb-related" aria-labelledby="related-title" data-pagefind-ignore>
            <h2 id="related-title">{t("paper.related")}</h2>
            <ul>
              {related.map(({ entry }) => (
                <li>
                  <a href={`/${lang}/paper/${entry.data.slug}`} lang={contentLangOf(entry)}>{entry.data.title}</a>
                  {entry.data.author && <span class="hb-related-author"> · {splitAuthor(entry.data.author).name}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
        <LicenseNotice lang={lang} />
      </article>
    </div>
  </div>
</BaseLayout>
