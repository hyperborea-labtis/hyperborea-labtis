---
// "Últimas publicaciones", page 1 — target of the home's "Ver más". Same URL as
// the current Drupal site (/es/posts-3-col); pages 2+ are posts-3-col/[n].astro.
import type { GetStaticPaths } from "astro";
import PublicationsPage from "../../components/PublicationsPage.astro";
import { locales, type Locale } from "../../i18n/config";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<PublicationsPage lang={lang} page={1} />
