---
// The old Drupal search lived at /{lang}/search/node?keys=… — forward it to the
// new search page so saved links and bookmarks keep working.
import type { GetStaticPaths } from "astro";
import { locales, type Locale } from "../../../i18n/config";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Hyperborea</title>
    <script is:inline define:vars={{ lang }}>
      const keys = new URLSearchParams(location.search).get("keys") || "";
      location.replace("/" + lang + "/buscar" + (keys ? "?q=" + encodeURIComponent(keys) : ""));
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=/${lang}/buscar`} /></noscript>
  </head>
  <body></body>
</html>
