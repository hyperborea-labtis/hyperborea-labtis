---
// Keyword pages of the old Drupal site (/es/taxonomy/term/976). They are already
// indexed by search engines, so every term id keeps its URL. The list is built
// from the papers' `keywords` frontmatter. The vocabulary is
// src/data/keywords/ (one file per term, editable in the CMS; old Drupal term ids refreshed
// with `npm run import:terms`); terms added in the CMS get a slug as their id.
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageTitle from "../../../../components/PageTitle.astro";
import PaperCard from "../../../../components/PaperCard.astro";
import { locales, type Locale } from "../../../../i18n/config";
import { papersWithKeyword, langIfDifferent, norm } from "../../../../lib/content";
import { keywordPages, termIdByName } from "../../../../lib/keywords";
import { keywordDescription, keywordTitle } from "../../../../lib/descriptions";

export const getStaticPaths = (async () => {
  return locales.flatMap((lang) =>
    keywordPages.map(({ id, name }) => ({ params: { lang, tid: id }, props: { name } })),
  );
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const { tid } = Astro.params;
const { name } = Astro.props;
const papers = await papersWithKeyword(lang, name);
// Merged Drupal ids (`alsoTids`) keep their URLs but duplicate the primary term's page.
const primaryId = termIdByName.get(norm(name)) ?? tid;
---

<BaseLayout
  title={keywordTitle(lang, name)}
  canonicalPath={`/taxonomy/term/${primaryId}`}
  breadcrumbs={[{ name: keywordTitle(lang, name), path: `/taxonomy/term/${tid}` }]}
  description={keywordDescription(lang, { name, count: papers.length })}
  lang={lang}
  path={`/taxonomy/term/${tid}`}
  contentLang="es"
  alternates={["es"]}
>
  <div class="hb-main">
    <div class="hb-container">
      <PageTitle text={name} />
      <div class="hb-grid">
        {
          papers.map((p) => (
            <PaperCard
              title={p.data.title}
              href={`/${lang}/paper/${p.data.slug}`}
              image={p.data.heroImage}
              columns={2}
              titleLang={langIfDifferent(p, lang)}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
