{
  // Cloudflare Worker with static assets: the Astro build (dist/) plus a tiny
  // Worker for POST /api/contact. Deploy: `npm run build` then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperborea-labtis",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // The Worker only runs for the API; everything else is served as static files
    // (and dist/_redirects gives the 301s that keep the old Drupal URLs alive).
    "run_worker_first": ["/api/*"],
    // URLs have no trailing slash (/es/numero-1, not /es/numero-1/).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Contact form. CONTACT_TO, CONTACT_FROM and TURNSTILE_SECRET are SECRETS (not
  // committed: the repository is public); see README. Do NOT declare them with
  // `secrets.required`: wrangler deploy then fails while any of them is unset, and the
  // form is meant to stay suspended until they are. Their names reach the generated Env
  // through worker/secrets.example (see `npm run types`). The recipient is always
  // CONTACT_TO: user input never controls it.
  "send_email": [{ "name": "EMAIL" }],
  // At most 5 submissions per minute per IP (checked before Turnstile is called).
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Errors in the Worker are invisible without this (see `wrangler tail` / dashboard Logs).
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
